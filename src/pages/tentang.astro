---
// Sumber konten: vault/konten/tentang.md (publik: ya)
import Layout from '../layouts/Layout.astro';

const bidang = [
	{ nama: 'Desain grafis' },
	{ nama: 'UI/UX' },
	{ nama: 'Ilustrasi & concept art' },
	{ nama: 'Komik' },
	{ nama: 'Video editing' },
	{ nama: 'Animasi AI', catatan: 'sedang dipelajari' },
];
---

<Layout
	title="Tentang"
	description="Di balik Qalam Rupa: mofajar — desainer visual. Ruang untuk berkarya dan berbagi."
>
	<h1>Di balik Qalam Rupa: mofajar</h1>

	<p class="lead">
		Desainer visual dengan pengalaman 4 tahun di UI/UX dan 5 tahun di desain grafis. Sehari-hari
		merancang materi visual untuk beberapa brand, berkutat dengan bentuk dan warna.
	</p>

	<p>
		<strong>Qalam</strong> berarti pena — simbol ilmu. <strong>Rupa</strong> berarti wujud visual. Qalam
		Rupa adalah ruang untuk berkarya dan berbagi: portfolio, catatan belajar, dan eksperimen animasi
		berbasis AI.
	</p>

	<section class="bidang" aria-labelledby="judul-bidang">
		<h2 id="judul-bidang">Bidang</h2>
		<ul class="chip-daftar">
			{
				bidang.map((b) => (
					<li class:list={['chip', { 'chip-belajar': b.catatan }]}>
						{b.nama}
						{b.catatan && <span class="chip-catatan">{b.catatan}</span>}
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.bidang {
		margin-top: 2.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--garis);
	}
	.bidang h2 {
		font-size: 1.5rem;
	}
	.chip-daftar {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
	}
	.chip {
		display: inline-flex;
		align-items: baseline;
		gap: 0.45rem;
		padding: 0.4rem 0.95rem;
		border: 1px solid var(--tinta);
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.3;
	}
	.chip-belajar {
		border-style: dashed;
		border-color: var(--aksen);
		color: var(--aksen);
	}
	.chip-catatan {
		font-size: 0.8rem;
		font-weight: 400;
		opacity: 0.85;
	}
</style>
