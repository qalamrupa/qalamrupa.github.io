---
// Halaman Bookmark — situs & alat pilihan untuk berkarya.
// Sumber: vault/bookmark/*.md (hanya publik: ya), frontmatter-nya disalin ke src/data/bookmark/.
// Yang tampil: judul, link, kategori, alesan, pilihan. Catatan pribadi (isi di bawah frontmatter) tidak pernah disalin.
import Layout from '../layouts/Layout.astro';

type Bookmark = {
	judul: string;
	link: string;
	kategori: string;
	alesan: string;
	tanggal: string | Date;
	pilihan?: string | boolean;
	publik: string | boolean;
};

const URUTAN_KATEGORI = [
	'Inspirasi desain',
	'UI & motion',
	'Ilustrasi & komik',
	'Animasi & video AI',
	'Font & warna',
	'Mockup & aset gratis',
	'Tools AI',
	'Belajar',
];

const ya = (v: unknown) => v === true || v === 'ya';

const modul = import.meta.glob<{ frontmatter: Bookmark }>('../data/bookmark/*.md', { eager: true });
const daftar = Object.values(modul)
	.map((m) => m.frontmatter)
	.filter((b) => b && ya(b.publik) && b.judul && b.link)
	.map((b) => ({ ...b, pilihan: ya(b.pilihan), waktu: new Date(b.tanggal).getTime() || 0 }))
	.sort((a, b) => Number(b.pilihan) - Number(a.pilihan) || b.waktu - a.waktu);

const kategoriAda = URUTAN_KATEGORI.filter((k) => daftar.some((b) => b.kategori === k)).concat(
	[...new Set(daftar.map((b) => b.kategori))].filter((k) => !URUTAN_KATEGORI.includes(k)),
);
const hitung = (k: string) => daftar.filter((b) => b.kategori === k).length;
const nomor = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout title="Bookmark" description="Situs & alat pilihan untuk berkarya — dikurasi oleh Qalam Rupa.">
	<div class="atas">
		<div>
			<h1>Bookmark</h1>
			<p class="sub">Situs &amp; alat pilihan untuk berkarya.</p>
		</div>
		<div class="atas-kanan">
			<div class="hitungan" aria-live="polite">
				<span class="hitungan-angka" data-jumlah>{daftar.length}</span>
				<span class="hitungan-label">bookmark tampil</span>
			</div>
			{
				daftar.length >= 3 && (
					<button type="button" class="kejutan" data-kejutan>
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5" /><path d="M4 20L21 3" /><path d="M21 16v5h-5" /><path d="M15 15l6 6" /><path d="M4 4l5 5" /></svg>
						Kejutan
					</button>
				)
			}
		</div>
	</div>

	{
		daftar.length === 0 ? (
			<p class="catetan">Bookmark pertama segera hadir.</p>
		) : (
			<>
				<div class="alat">
					<div role="group" aria-label="Saring kategori" class="chip-daftar">
						<button type="button" class="chip aktif" aria-pressed="true" data-kat="Semua">
							Semua<span class="angka" data-angka="Semua">{daftar.length}</span>
						</button>
						{kategoriAda.map((k) => (
							<button type="button" class="chip" aria-pressed="false" data-kat={k}>
								{k}<span class="angka" data-angka={k}>{hitung(k)}</span>
							</button>
						))}
					</div>
					<div class="cari">
						<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
						<label for="cari-bookmark" class="sr-only">Cari bookmark</label>
						<input id="cari-bookmark" type="search" placeholder="Cari…" autocomplete="off" data-cari />
					</div>
				</div>

				<p class="kosong" data-kosong hidden>Tidak ada yang cocok. Coba kata lain.</p>

				<ol class="daftar">
					{daftar.map((b, i) => (
						<li
							class="baris"
							style={`--i: ${i}`}
							data-baris
							data-kat={b.kategori}
							data-teks={`${b.judul} ${b.alesan} ${b.kategori}`.toLowerCase()}
						>
							<span class="no" data-no>{nomor(i)}</span>
							<div class="isi">
								<a class="ngaran" href={b.link} target="_blank" rel="noopener noreferrer">
									{b.judul}
									<span class="sr-only"> (buka di tab baru)</span>
								</a>
								{b.pilihan && <span class="tanda" data-tanda-pilihan>Pilihan</span>}
								<span class="tanda" data-tanda-coba hidden>Coba ini</span>
								<div class="deskripsi">{b.alesan}</div>
								<div class="meta-hp">{b.kategori}</div>
							</div>
							<span class="kategori">{b.kategori}</span>
							<svg class="panah" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
						</li>
					))}
				</ol>
			</>
		)
	}
</Layout>

<script>
	const baris = Array.from(document.querySelectorAll<HTMLElement>('[data-baris]'));
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-kat].chip'));
	const cari = document.querySelector<HTMLInputElement>('[data-cari]');
	const jumlah = document.querySelector<HTMLElement>('[data-jumlah]');
	const kosong = document.querySelector<HTMLElement>('[data-kosong]');
	const kejutan = document.querySelector<HTMLButtonElement>('[data-kejutan]');

	let kat = 'Semua';
	let sorot: HTMLElement | null = null;

	function lepasSorot() {
		if (!sorot) return;
		sorot.classList.remove('sorot');
		sorot.querySelector<HTMLElement>('[data-tanda-coba]')?.setAttribute('hidden', '');
		sorot.querySelector<HTMLElement>('[data-tanda-pilihan]')?.removeAttribute('hidden');
		sorot = null;
	}

	function terapkan() {
		const q = (cari?.value || '').trim().toLowerCase();
		const cocokCari = baris.filter((b) => !q || (b.dataset.teks || '').includes(q));
		let n = 0;
		for (const b of baris) {
			const tampil = cocokCari.includes(b) && (kat === 'Semua' || b.dataset.kat === kat);
			b.hidden = !tampil;
			if (tampil) {
				n += 1;
				const no = b.querySelector<HTMLElement>('[data-no]');
				if (no) no.textContent = String(n).padStart(2, '0');
			}
		}
		for (const c of chips) {
			const k = c.dataset.kat || '';
			const angka = c.querySelector<HTMLElement>('[data-angka]');
			if (angka) angka.textContent = String(k === 'Semua' ? cocokCari.length : cocokCari.filter((b) => b.dataset.kat === k).length);
		}
		if (jumlah) jumlah.textContent = String(n);
		if (kosong) kosong.hidden = n !== 0;
		if (sorot && sorot.hidden) lepasSorot();
	}

	for (const c of chips) {
		c.addEventListener('click', () => {
			kat = c.dataset.kat || 'Semua';
			for (const x of chips) {
				const aktif = x === c;
				x.classList.toggle('aktif', aktif);
				x.setAttribute('aria-pressed', String(aktif));
			}
			terapkan();
		});
	}
	cari?.addEventListener('input', terapkan);

	kejutan?.addEventListener('click', () => {
		const calon = baris.filter((b) => !b.hidden && b !== sorot);
		if (calon.length === 0) return;
		lepasSorot();
		const pilih = calon[Math.floor(Math.random() * calon.length)];
		pilih.classList.add('sorot');
		pilih.querySelector<HTMLElement>('[data-tanda-pilihan]')?.setAttribute('hidden', '');
		pilih.querySelector<HTMLElement>('[data-tanda-coba]')?.removeAttribute('hidden');
		const tenang = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		pilih.scrollIntoView({ block: 'nearest', behavior: tenang ? 'auto' : 'smooth' });
		sorot = pilih;
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.atas {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}
	.atas h1 {
		margin-bottom: 0.2em;
	}
	.sub {
		margin: 0;
		font-size: 1.1rem;
		color: rgba(27, 42, 58, 0.78);
	}
	.atas-kanan {
		display: flex;
		align-items: flex-end;
		gap: 1.2rem;
	}
	.hitungan {
		text-align: right;
	}
	.hitungan-angka {
		display: block;
		font-family: var(--font-judul);
		font-weight: 600;
		font-size: 3.5rem;
		line-height: 1;
		color: var(--aksen);
		font-variant-numeric: tabular-nums;
	}
	.hitungan-label {
		font-size: 0.8rem;
		color: rgba(27, 42, 58, 0.65);
	}
	.kejutan {
		min-height: 44px;
		padding: 0 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--aksen);
		background: transparent;
		color: var(--aksen);
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: background 0.2s, color 0.2s;
	}
	.kejutan:hover {
		background: var(--aksen);
		color: var(--latar);
	}
	.alat {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}
	.chip-daftar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		min-height: 44px;
		padding: 0 1rem;
		border-radius: 999px;
		border: 1px solid var(--tinta);
		background: transparent;
		color: var(--tinta);
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	.chip:hover {
		background: rgba(27, 42, 58, 0.08);
	}
	.chip.aktif {
		background: var(--tinta);
		color: var(--latar);
	}
	.angka {
		font-weight: 400;
		opacity: 0.7;
		margin-left: 0.3rem;
	}
	.cari {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		max-width: 360px;
		border-bottom: 1px solid rgba(27, 42, 58, 0.35);
		color: rgba(27, 42, 58, 0.6);
	}
	.cari input {
		flex: 1;
		min-width: 0;
		height: 44px;
		border: 0;
		background: transparent;
		font: inherit;
		color: var(--tinta);
	}
	.cari input:focus {
		outline: none;
	}
	.cari:focus-within {
		border-bottom-color: var(--tinta);
	}
	.kosong {
		padding: 2.5rem 0;
		text-align: center;
		color: rgba(27, 42, 58, 0.7);
	}
	.daftar {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.baris {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr) 170px 24px;
		align-items: center;
		gap: 1rem;
		padding: 1rem;
		border-bottom: 1px solid rgba(27, 42, 58, 0.14);
		animation: muncul 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		animation-delay: calc(var(--i) * 45ms);
	}
	.baris[hidden] {
		display: none;
	}
	.baris::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--tinta);
		border-radius: 12px;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
		z-index: -1;
	}
	.baris:hover::before,
	.baris:focus-within::before {
		transform: scaleX(1);
	}
	.baris:hover,
	.baris:focus-within {
		border-bottom-color: transparent;
	}
	.baris:hover .ngaran,
	.baris:focus-within .ngaran,
	.baris:hover .panah,
	.baris:focus-within .panah {
		color: var(--latar);
	}
	.baris:hover .no,
	.baris:hover .deskripsi,
	.baris:hover .kategori,
	.baris:hover .meta-hp,
	.baris:focus-within .no,
	.baris:focus-within .deskripsi,
	.baris:focus-within .kategori,
	.baris:focus-within .meta-hp {
		color: rgba(246, 241, 231, 0.75);
	}
	.baris:hover .panah,
	.baris:focus-within .panah {
		transform: translateX(4px) rotate(-45deg);
	}
	.baris.sorot {
		outline: 2px solid var(--aksen);
		outline-offset: -2px;
		border-radius: 12px;
	}
	.no {
		font-variant-numeric: tabular-nums;
		font-size: 0.85rem;
		color: rgba(27, 42, 58, 0.5);
	}
	.isi {
		min-width: 0;
	}
	.ngaran {
		font-family: var(--font-judul);
		font-weight: 600;
		font-size: 1.4rem;
		line-height: 1.15;
		color: var(--tinta);
		text-decoration: none;
	}
	.ngaran::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.ngaran:focus-visible {
		outline: none;
	}
	.tanda {
		display: inline-block;
		margin-left: 0.5rem;
		vertical-align: middle;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--latar);
		background: var(--aksen);
		padding: 2px 8px;
		border-radius: 999px;
	}
	.tanda[hidden] {
		display: none;
	}
	.deskripsi {
		font-size: 0.85rem;
		color: rgba(27, 42, 58, 0.7);
		margin-top: 2px;
	}
	.kategori {
		font-size: 0.85rem;
		color: rgba(27, 42, 58, 0.75);
	}
	.meta-hp {
		display: none;
	}
	.panah {
		color: var(--tinta);
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.2s;
	}
	@keyframes muncul {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (max-width: 600px) {
		.baris {
			grid-template-columns: 28px minmax(0, 1fr) 22px;
			gap: 0.6rem;
			padding: 0.9rem 0.5rem;
		}
		.kategori {
			display: none;
		}
		.meta-hp {
			display: block;
			font-size: 0.8rem;
			color: rgba(27, 42, 58, 0.65);
			margin-top: 4px;
		}
		.ngaran {
			font-size: 1.2rem;
		}
		.hitungan-angka {
			font-size: 2.6rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.baris {
			animation: none;
		}
		.baris::before,
		.panah,
		.chip,
		.kejutan {
			transition: none;
		}
	}
</style>
